@model IEnumerable<Watchlist.Models.ModelViewFilm>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Year)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Watched)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr id="film-@item.IdFilm">
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Year)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Watched)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.IdFilm">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.IdFilm">Details</a> |
                    <button class="btn btn-danger" onclick="RemoveFilmFromList(@item.IdFilm)">Delete</button>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts{
    <script>
        function RemoveFilmFromList(id){
            $.get('/Films/AddRemove?id=' + id + '&val=1', function (data){
                    if (data == 0){
                        $("#film-" + id).remove();
                    }
                });
            
        }

    </script>
}